<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModForge</RootNamespace>
    <!-- .NET 9+ enables CET/shadow-stack by default, which Mod Organizer 2 fails to launch under.
         This tool's output is consumed by MO2 users and may itself be run inside MO2 — disable it.
         (Mutagen best-practice: Mo2-Compatibility.) -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModForge.Core\ModForge.Core.csproj" />
  </ItemGroup>

  <!-- The generic Story-Event dispatcher .pex (compiled once from assets/papyrus/*.psc). Embedded so
       `package` can drop it into Scripts/ for any mod using event "ScriptEvent", regardless of CWD. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\papyrus\MFStoryEventDispatch.pex">
      <LogicalName>MFStoryEventDispatch.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
