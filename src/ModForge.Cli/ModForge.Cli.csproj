<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModForge</RootNamespace>
    <!-- .NET 9+ enables CET/shadow-stack by default, which Mod Organizer 2 fails to launch under.
         This tool's output is consumed by MO2 users and may itself be run inside MO2 — disable it.
         (Mutagen best-practice: Mo2-Compatibility.) -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModForge.Core\ModForge.Core.csproj" />
  </ItemGroup>

  <!-- The generic Story-Event dispatcher .pex (compiled once from assets/papyrus/*.psc). Embedded so
       `package` can drop it into Scripts/ for any mod using event "ScriptEvent", regardless of CWD.
       Conditional: build succeeds without it (fresh clone / CI); `package` on a ScriptEvent spec
       will warn at runtime that the .pex is missing. Compile it with:
         dotnet run - - compile assets/papyrus/MFStoryEventDispatch.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFStoryEventDispatch.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFStoryEventDispatch.pex">
      <LogicalName>MFStoryEventDispatch.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The dispatcher SOURCE (always in repo; only the .pex is gitignored). Embedded so `package` can
       drop it beside any user script that calls MFStoryEventDispatch.Fire(), giving the Papyrus
       compiler the header it needs to resolve the dispatcher — no per-machine cache install. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\papyrus\MFStoryEventDispatch.psc">
      <LogicalName>MFStoryEventDispatch.psc</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The reusable presence-gated Scene controller .pex (extends Quest; started by scenes with
       `autoStart`). Embedded so `package` can drop it into Scripts/ for any mod using a presence-gated
       scene, regardless of CWD. Conditional: build succeeds without it (fresh clone / CI); `package`
       on an autoStart spec will warn at runtime that the .pex is missing. Compile it with:
         dotnet run - - compile assets/papyrus/MFSceneBanterController.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFSceneBanterController.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFSceneBanterController.pex">
      <LogicalName>MFSceneBanterController.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The reusable SM-encounter cooldown .pex (extends Quest; TryFire() returns False if it re-fired
       within `cooldownHours`). Embedded so `package` can drop it into Scripts/ for any mod whose
       storyEvent quests declare cooldownHours. Conditional: build succeeds without it; `package` warns
       at runtime if missing. Compile it with:
         dotnet run - - compile assets/papyrus/MFEncounterCooldown.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFEncounterCooldown.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFEncounterCooldown.pex">
      <LogicalName>MFEncounterCooldown.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The cooldown/spawn SOURCES (always in repo; only the .pex are gitignored). Embedded so `package`
       can drop them beside the generated <quest>_Stages fragment, giving the Papyrus compiler the
       headers it needs to resolve `self as MFEncounterCooldown` / `self as MFDynamicSpawn` casts. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\papyrus\MFEncounterCooldown.psc">
      <LogicalName>MFEncounterCooldown.psc</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\papyrus\MFDynamicSpawn.psc">
      <LogicalName>MFDynamicSpawn.psc</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The reusable in-world skill-tree node .pex (extends ObjectReference; OnActivate gate-checks +
       AddSpell + PlayAnimation "OwnedWild"/line "Unlock"; Idea #20). Embedded so `package` can drop it
       into Scripts/ for any mod that declares a skillTree. Conditional: build succeeds without it;
       `package` warns at runtime if missing. Compile it with:
         dotnet run - - compile assets/papyrus/MFSkillNode.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFSkillNode.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFSkillNode.pex">
      <LogicalName>MFSkillNode.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Living-world NPCs (Idea #23). Two reusable .pex serve every generated mod: the per-mod world
       controller (roster game-time tick + real-time presence poll) and the per-NPC alias script
       (abstract ghost-sim + materialize on co-location). Embedded so `package` drops them into Scripts/
       for any mod with a `livingNpcs:` section. Conditional: build succeeds without them; `package`
       warns at runtime if missing. Compile them with:
         dotnet run - - compile assets/papyrus/MFLivingWorldController.psc assets/papyrus/
         dotnet run - - compile assets/papyrus/MFLivingNpcAlias.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFLivingWorldController.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFLivingWorldController.pex">
      <LogicalName>MFLivingWorldController.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFLivingNpcAlias.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFLivingNpcAlias.pex">
      <LogicalName>MFLivingNpcAlias.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The reusable dynamic near-player spawn .pex (extends Quest; OnInit spawns Count of SpawnForm
       around the player + snaps to navmesh). Embedded so `package` can drop it into Scripts/ for any
       mod whose quests declare `spawn`. Conditional: build succeeds without it; `package` warns at
       runtime if missing. Compile it with:
         dotnet run - - compile assets/papyrus/MFDynamicSpawn.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFDynamicSpawn.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFDynamicSpawn.pex">
      <LogicalName>MFDynamicSpawn.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The reusable identity-acquire book .pex (extends ObjectReference; OnRead joins/leaves an identity faction).
       Embedded so `package` can drop it into Scripts/ for any mod whose identities declare an acquireBook.
       Conditional: build succeeds without it; `package` warns at runtime if missing. Compile it with:
         dotnet run - - compile assets/papyrus/MFIdentityBook.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFIdentityBook.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFIdentityBook.pex">
      <LogicalName>MFIdentityBook.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The reusable default-identity granter .pex (extends Quest; OnInit grants `default:true` identities).
       Embedded so `package` can drop it into Scripts/ for any mod whose identities declare a default.
       Conditional: build succeeds without it; `package` warns at runtime if missing. Compile it with:
         dotnet run - - compile assets/papyrus/MFIdentityDefault.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFIdentityDefault.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFIdentityDefault.pex">
      <LogicalName>MFIdentityDefault.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The reusable primary-identity controller .pex (extends Quest; maintains MF_PrimaryIdentity).
       Embedded so `package` can drop it into Scripts/ for any mod whose dialogue uses primaryIdentity.
       Conditional: build succeeds without it; `package` warns at runtime if missing. Compile it with:
         dotnet run - - compile assets/papyrus/MFIdentityController.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFIdentityController.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFIdentityController.pex">
      <LogicalName>MFIdentityController.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The reusable identity auto-grant trigger .pex (extends Quest; joins a faction when a player AV
       crosses a threshold, e.g. Dragonborn on DragonSouls>=1). Embedded so `package` can drop it into
       Scripts/ for any mod whose identities use autoGrantWhen. Compile it with:
         dotnet run - - compile assets/papyrus/MFIdentityAutoGrant.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\MFIdentityAutoGrant.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\MFIdentityAutoGrant.pex">
      <LogicalName>MFIdentityAutoGrant.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The reusable MCM Helper config host .pex (extends MCM_ConfigBase; attached to a Start-Game-Enabled
       QUST whose ModName property points at Data/MCM/Config/<ModName>/). Embedded so `package` can drop it
       into Scripts/ for any mod with mcmConfigs. Needs MCM Helper + SkyUI SDK headers to compile (not the
       vanilla set) — provision MCM_ConfigBase.psc / SKI_*.psc into the header cache first, then:
         dotnet run - - compile assets/papyrus/ModForgeMCM.psc assets/papyrus/ -->
  <ItemGroup Condition="Exists('..\..\assets\papyrus\ModForgeMCM.pex')">
    <EmbeddedResource Include="..\..\assets\papyrus\ModForgeMCM.pex">
      <LogicalName>ModForgeMCM.pex</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
