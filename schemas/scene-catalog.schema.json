{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modforge.dev/schemas/scene-catalog.schema.json",
  "title": "ModForge scene-capture catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin", "sourcePath", "sha256", "localized", "recordCount", "loadOrderIndex"],
      "properties": {
        "plugin": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "localized": { "type": "boolean" },
        "recordCount": { "type": "integer", "minimum": 0 },
        "loadOrderIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formKey", "plugin", "recordType", "editorId", "name", "modelPath", "sourcePlugin", "sourcePath"],
      "properties": {
        "formKey": { "type": "string", "pattern": "^.+\\.[eE][sS][mMpPlL]:0x[0-9A-F]{6}$" },
        "plugin": { "type": "string", "minLength": 1 },
        "recordType": { "type": "string", "minLength": 1 },
        "editorId": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "modelPath": { "type": ["string", "null"] },
        "sourcePlugin": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
