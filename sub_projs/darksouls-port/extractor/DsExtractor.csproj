<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- ThirdParty/ holds gitignored source clones (SoulsFormats fallback, and
       Python soulstruct/soulstruct-havok used by tools/). Never compile them
       into this C# project. -->
  <ItemGroup>
    <Compile Remove="ThirdParty/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- SoulsFormatsNEXT source clone replaces the JuicerMV.SoulsFormats NuGet:
         the NuGet fork throws on DS1R layout/stride mismatch (m0001B1A18),
         SFNEXT carries DarkSoulsRemasteredFix() for exactly that. -->
    <ProjectReference Include="ThirdParty/SoulsFormatsNEXT/SoulsFormats/SoulsFormats.csproj" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
  </ItemGroup>

</Project>
