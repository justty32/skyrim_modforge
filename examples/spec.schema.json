{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modforge/spec.schema.json",
  "title": "ModForge plugin spec",
  "description": "Describes the content of one Skyrim plugin. See docs/SPEC.md. Property names are matched case-insensitively by the generator.",
  "type": "object",
  "properties": {
    "pluginName": { "type": "string", "description": "Output filename / ModKey, e.g. MyMod.esp" },
    "esl": { "type": "boolean", "default": true, "description": "Light-master flag; keep new records <= 4096" },
    "miscItems": { "type": "array", "items": { "$ref": "#/$defs/named" } },
    "books": { "type": "array", "items": { "$ref": "#/$defs/book" } },
    "weapons": { "type": "array", "items": { "$ref": "#/$defs/weapon" } },
    "npcs": { "type": "array", "items": { "$ref": "#/$defs/npc" } },
    "quests": { "type": "array", "items": { "$ref": "#/$defs/quest" } },
    "dialogue": { "type": "array", "items": { "$ref": "#/$defs/dialogue" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" }, "description": "Relationship (RELA): a directed NPC_-to-NPC_ bond at a rank; child defaults to the player NPC base 0x000014" },
    "combatStyles": { "type": "array", "items": { "$ref": "#/$defs/combatStyle" }, "description": "CombatStyle (CSTY): HOW an NPC fights; reference via npc.combatStyle" },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/package" }, "description": "AI Package (PACK); assign via npc.packages. See SPEC.md for the template-input subobjects" },
    "spells": { "type": "array", "items": { "$ref": "#/$defs/spell" } },
    "magicEffects": { "type": "array", "items": { "$ref": "#/$defs/magicEffect" }, "description": "custom MGEF records an effect can point at by editorId" },
    "potions": { "type": "array", "items": { "$ref": "#/$defs/potion" } },
    "armors": { "type": "array", "items": { "$ref": "#/$defs/armor" } },
    "factions": { "type": "array", "items": { "$ref": "#/$defs/faction" }, "description": "Faction (FACT); add a `vendor` sub-object to make members shopkeepers" },
    "classes": { "type": "array", "items": { "$ref": "#/$defs/class" }, "description": "Class (CLAS): an npc 'profession' (attribute/skill weights); an npc class can point at one" },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "scripts": { "type": "array", "items": { "$ref": "#/$defs/script" } },
    "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" }, "description": "new interior cells (reach in-game via `coc <editorId>`)" },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placement" }, "description": "put a base form into a cell at a position/rotation" },
    "leveledItems": { "type": "array", "items": { "$ref": "#/$defs/leveledList" }, "description": "LeveledItem (LVLI): level-gated weighted item lists" },
    "leveledNpcs": { "type": "array", "items": { "$ref": "#/$defs/leveledList" }, "description": "LeveledNpc (LVLN): level-gated weighted npc lists" },
    "containers": { "type": "array", "items": { "$ref": "#/$defs/container" }, "description": "Container (CONT): a named container with item contents" },
    "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" }, "description": "Ingredient (INGR): alchemy reagent with effects" },
    "ammunitions": { "type": "array", "items": { "$ref": "#/$defs/ammunition" }, "description": "Ammunition (AMMO): arrow/bolt with damage" },
    "scrolls": { "type": "array", "items": { "$ref": "#/$defs/scroll" }, "description": "Scroll (SCRL): one-shot spell-as-item with effects + cast fields" },
    "soulGems": { "type": "array", "items": { "$ref": "#/$defs/soulGem" }, "description": "SoulGem (SLGM)" },
    "keys": { "type": "array", "items": { "$ref": "#/$defs/key" }, "description": "Key (KEYM)" },
    "keywords": { "type": "array", "items": { "$ref": "#/$defs/keyword" }, "description": "Keyword (KYWD): define your own so in-spec records can reference it" },
    "outfits": { "type": "array", "items": { "$ref": "#/$defs/outfit" }, "description": "Outfit (OTFT): a set of item refs an NPC can wear" },
    "statics": { "type": "array", "items": { "$ref": "#/$defs/staticRec" }, "description": "Static (STAT): a world mesh (model path)" },
    "activators": { "type": "array", "items": { "$ref": "#/$defs/activator" }, "description": "Activator (ACTI): an interactable world object" },
    "recipes": { "type": "array", "items": { "$ref": "#/$defs/recipe" }, "description": "ConstructibleObject (COBJ): crafting recipes" },
    "enchantments": { "type": "array", "items": { "$ref": "#/$defs/enchantment" }, "description": "Enchantment / Object Effect (ENCH): MGEF-based effects bundled into a weapon/staff/apparel enchantment a weapon/armor references via its `enchantment` field" }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "description": "A reference: an in-spec editorId OR an external form '<master>:0xFORMID' (e.g. 'Skyrim.esm:0x013746' = NordRace). Discover FormIDs with the `find` command."
    },
    "effect": {
      "type": "object",
      "required": ["magicEffect"],
      "properties": {
        "magicEffect": { "$ref": "#/$defs/ref", "description": "MagicEffect ref — a vanilla one (e.g. 'Skyrim.esm:0x03EB15' = AlchRestoreHealth; find <Skyrim.esm> <query> MagicEffect) OR an in-spec magicEffects entry's editorId" },
        "magnitude": { "type": "number", "minimum": 0 },
        "area": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 0, "description": "seconds; 0 = instant" }
      }
    },
    "weapon": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "damage": { "type": "integer", "minimum": 0, "description": "base damage; functional weapon needs this > 0" },
        "speed": { "type": "number", "minimum": 0, "description": "swing speed (~1.0 normal); defaults to 1.0 if any stat is set" },
        "reach": { "type": "number", "minimum": 0, "description": "reach (~1.0 normal); defaults to 1.0 if any stat is set" },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "enchantment": { "$ref": "#/$defs/ref", "description": "ENCH ref — an in-spec enchantments entry or a vanilla ObjectEffect (<master>:0xFORMID)" },
        "enchantmentAmount": { "type": "integer", "minimum": 0, "description": "the weapon's charge pool (casts before recharge); e.g. 1500-3000; 0 = engine auto-calc" }
      }
    },
    "enchantment": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "enchantType": { "enum": ["weapon", "apparel", "armor", "staff"], "default": "weapon", "description": "weapon = cast-on-strike (charge); apparel = constant-effect (always-on while worn); staff = staff cast-on-use (charge)" },
        "castType": { "enum": ["ConstantEffect", "FireAndForget", "Concentration"], "description": "optional — overrides the per-enchantType default" },
        "targetType": { "enum": ["Self", "Touch", "Aimed", "TargetActor", "TargetLocation"], "description": "optional — overrides the per-enchantType default" },
        "enchantmentCost": { "type": "integer", "minimum": 0, "description": "per-cast charge cost (weapon/staff) / worn cost (apparel)" },
        "chargeTime": { "type": "number", "minimum": 0, "description": "staff cast charge-up (vanilla staves ~0.5)" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" }, "description": "MGEF-based effects (needs at least one)" }
      }
    },
    "spell": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" }, "description": "magic effects (does nothing without at least one)" },
        "spellType": { "enum": ["Spell", "Disease", "Power", "LesserPower", "Ability", "Poison", "Addiction", "Voice"] },
        "castType": { "enum": ["ConstantEffect", "FireAndForget", "Concentration"] },
        "targetType": { "enum": ["Self", "Touch", "Aimed", "TargetActor", "TargetLocation"] },
        "baseCost": { "type": "integer", "minimum": 0, "description": "magicka cost" },
        "chargeTime": { "type": "number", "minimum": 0 }
      }
    },
    "magicEffect": {
      "type": "object",
      "required": ["editorId"],
      "description": "a custom MGEF; reference it from an effect's magicEffect by editorId",
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "archetype": { "enum": ["ValueModifier", "Script", "Dispel", "CureDisease", "Absorb", "DualValueModifier", "Calm", "Demoralize", "Frenzy", "Disarm", "CommandSummoned", "Invisibility", "Light", "Lock", "Open", "Bound", "SummonCreature", "DetectLife", "Telekinesis", "Paralysis", "Reanimate", "SoulTrap", "TurnUndead", "Guide", "WerewolfFeed", "CureParalysis", "CureAddiction", "CurePoison", "Concussion", "ValueAndParts", "AccumulateMagnitude", "Stagger", "PeakValueModifier", "Cloak", "Werewolf", "SlowTime", "Rally", "EnhanceWeapon", "SpawnHazard", "Etherealize", "Banish", "SpawnScriptedRef", "Disguise", "GrabActor", "VampireLord"], "description": "what the effect does; ValueModifier is the common damage/heal/fortify" },
        "actorValue": { "type": "string", "description": "the actor value it acts on, e.g. Health, Magicka, Stamina, MagickaRate" },
        "magicSkill": { "type": "string", "description": "school: Alteration|Conjuration|Destruction|Illusion|Restoration (or None)" },
        "resistValue": { "type": "string", "description": "actor value that resists it, e.g. ResistFire, ResistFrost, PoisonResist (or None)" },
        "castType": { "enum": ["ConstantEffect", "FireAndForget", "Concentration"] },
        "targetType": { "enum": ["Self", "Touch", "Aimed", "TargetActor", "TargetLocation"] },
        "baseCost": { "type": "number", "minimum": 0 },
        "flags": { "type": "array", "items": { "enum": ["Hostile", "Recover", "Detrimental", "SnapToNavmesh", "NoHitEvent", "DispelWithKeywords", "NoDuration", "NoMagnitude", "NoArea", "FXPersist", "GoryVisuals", "HideInUI", "NoRecast", "PowerAffectsMagnitude", "PowerAffectsDuration", "Painless", "NoHitEffect", "NoDeathDispel"] }, "description": "instant restore/damage: [NoDuration,NoArea] (+Hostile,Detrimental for damage); timed fortify: [Recover]. Recover on an instant effect cancels it." },
        "association": { "$ref": "#/$defs/ref", "description": "summoned/bound form ref (only for Summon/Bound-type archetypes)" },
        "projectile": { "$ref": "#/$defs/ref", "description": "PROJ ref — the bolt that travels; needed for an Aimed spell to be visible (e.g. Skyrim.esm:0x10FBEA)" },
        "castingArt": { "$ref": "#/$defs/ref", "description": "ARTO ref — FX at the caster's hands (e.g. Skyrim.esm:0x01B211)" },
        "hitEffectArt": { "$ref": "#/$defs/ref", "description": "ARTO ref — FX at the impact point" },
        "explosion": { "$ref": "#/$defs/ref", "description": "EXPL ref — AoE explosion on impact" }
      }
    },
    "potion": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" }, "description": "magic effects (a potion is fully functional with one)" }
      }
    },
    "named": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "keyword refs (weapons/misc; ignored on records that don't take keywords)" }
      }
    },
    "faction": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "vendor": {
          "type": "object",
          "description": "Vendor data (FACT VENV/VEND/VENC). Present => Vendor-flagged merchant faction; members are shopkeepers and the generic 'I'd like to trade' topic surfaces.",
          "properties": {
            "startHour": { "type": "integer", "minimum": 0, "maximum": 24, "description": "shop opens (0..24)" },
            "endHour": { "type": "integer", "minimum": 0, "maximum": 24, "description": "shop closes (0..24); must be > startHour" },
            "radius": { "type": "integer", "minimum": 0, "description": "sell radius (0 = engine default)" },
            "buysStolen": { "type": "boolean", "description": "OnlyBuysStolenItems — a fence" },
            "sellBuyList": { "$ref": "#/$defs/ref", "description": "FormList of VendorItem keywords (e.g. Skyrim.esm:0x06CB48 VendorItemsMisc)" },
            "notSellBuyList": { "type": "boolean", "description": "true => sellBuyList is a NOT-sell list (trade everything except)" },
            "merchantContainer": { "$ref": "#/$defs/ref", "description": "a PLACEMENT editorId: the placed merchant chest (gold + stock)" }
          }
        }
      }
    },
    "book": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "text": { "type": "string" },
        "template": { "type": "string", "description": "ref to a vanilla BOOK to clone a model from; a takeable/readable book needs one or it CRASHES on read" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "flags": { "type": "array", "items": { "enum": ["Teaches", "CantBeTaken"] }, "description": "Book.Flag names" },
        "teaches": {
          "type": "object",
          "description": "a teaching book: a spell tome (grants a SPEL) or a skill book (raises a Skill) on first read",
          "properties": {
            "kind": { "enum": ["spell", "skill"] },
            "spell": { "type": "string", "description": "ref to a SPEL (in-spec editorId or <master>:0xFORMID); when kind=spell" },
            "skill": { "enum": ["OneHanded", "TwoHanded", "Archery", "Block", "Smithing", "HeavyArmor", "LightArmor", "Pickpocket", "Lockpicking", "Sneak", "Alchemy", "Speech", "Alteration", "Conjuration", "Destruction", "Illusion", "Restoration", "Enchanting"], "description": "when kind=skill" }
          }
        }
      }
    },
    "armor": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "armorRating": { "type": "number", "minimum": 0 },
        "armorType": { "enum": ["light", "heavy", "clothing", "lightArmor", "heavyArmor"], "description": "armor class; default clothing" },
        "slots": { "type": "array", "items": { "type": "string" }, "description": "biped slots occupied, e.g. Body, Head, Hands, Feet, Forearms, Calves, Shield (BipedObjectFlag names)" },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "enchantment": { "$ref": "#/$defs/ref", "description": "ENCH ref — normally an in-spec apparel (constant-effect) enchantments entry, or a vanilla ObjectEffect (<master>:0xFORMID)" }
      }
    },
    "message": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "class": {
      "type": "object",
      "required": ["editorId"],
      "description": "Class (CLAS): an npc 'profession' — attribute/skill weights",
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "teaches": { "enum": ["OneHanded", "TwoHanded", "Archery", "Block", "Smithing", "HeavyArmor", "LightArmor", "Pickpocket", "Lockpicking", "Sneak", "Alchemy", "Speech", "Alteration", "Conjuration", "Destruction", "Illusion", "Restoration", "Enchanting"], "description": "a Skill the class can train (trainer NPCs)" },
        "maxTrainingLevel": { "type": "integer", "minimum": 0, "maximum": 255 },
        "healthWeight": { "type": "integer", "minimum": 0, "maximum": 255 },
        "magickaWeight": { "type": "integer", "minimum": 0, "maximum": 255 },
        "staminaWeight": { "type": "integer", "minimum": 0, "maximum": 255 },
        "skillWeights": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 255 }, "description": "Skill name -> 0-255 favour, e.g. {\"Destruction\":100}" }
      }
    },
    "npc": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "factions": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "faction refs (in-spec or external)" },
        "race": { "$ref": "#/$defs/ref", "description": "Race ref; needed (with class) for a functional actor" },
        "class": { "$ref": "#/$defs/ref", "description": "Class ref" },
        "outfit": { "$ref": "#/$defs/ref", "description": "Outfit ref -> DefaultOutfit" },
        "level": { "type": "integer", "minimum": 0, "description": "fixed level (0 = default); needed for class-based stat auto-calc" },
        "autoCalcStats": { "type": "boolean", "description": "derive H/M/S + skills from level + class (else flat 50/50/50 defaults)" },
        "packages": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "PACK refs; the NPC's AI package list, evaluated in order" },
        "voiceType": { "$ref": "#/$defs/ref", "description": "VTYP ref (e.g. MaleNord Skyrim.esm:0x013AE6); without one the NPC is silent" },
        "crimeFaction": { "$ref": "#/$defs/ref", "description": "FACT ref; city-citizen identity, required for cross-cell Travel" },
        "unique": { "type": "boolean", "description": "one-off actor (vs leveled); helps engine AI tracking + cross-cell travel" },
        "combatStyle": { "$ref": "#/$defs/ref", "description": "CSTY ref; HOW the AI fights (magic/melee/ranged preference)" },
        "spells": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "SPEL refs; the AI's spell list" },
        "aggression": { "enum": ["Unaggressive", "Aggressive", "VeryAggressive", "Frenzied"], "description": "WHETHER it initiates (default Unaggressive)" },
        "confidence": { "enum": ["Cowardly", "Cautious", "Average", "Brave", "Foolhardy"], "description": "flee-vs-stand once attacked (default Cowardly = flees)" },
        "assistance": { "enum": ["HelpsNobody", "HelpsAllies", "HelpsFriendsAndAllies"] },
        "mood": { "enum": ["Neutral", "Angry", "Fear", "Happy", "Sad", "Surprised", "Puzzled", "Disgusted"] },
        "energyLevel": { "type": "integer", "minimum": 0, "maximum": 100, "description": "vanilla actors typically 50" },
        "greeting": { "type": "string", "description": "Hello line; when this NPC has custom dialogue, a Hello info is auto-emitted so it is conversable. Empty => default line" }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["editorId", "parent"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "parent": { "$ref": "#/$defs/ref", "description": "NPC_ base ref (the relationship owner; usually the custom NPC)" },
        "child": { "$ref": "#/$defs/ref", "description": "NPC_ base ref; defaults to the Player NPC base Skyrim.esm:0x000014. NOTE: must be an NPC_, NOT PlayerRef 0x000007 (an ACHR) — that CRASHES on load" },
        "rank": { "enum": ["Lover", "Ally", "Confidant", "Friend", "Acquaintance", "Rival", "Foe", "Enemy", "Archnemesis"], "description": "Ally satisfies the vanilla free-follow gate" }
      }
    },
    "combatStyle": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "offensiveMult": { "type": "number" },
        "defensiveMult": { "type": "number" },
        "groupOffensiveMult": { "type": "number" },
        "equipMultMelee": { "type": "number" },
        "equipMultMagic": { "type": "number", "description": "raise well above the others to make the AI prefer spells" },
        "equipMultRanged": { "type": "number" },
        "equipMultShout": { "type": "number" },
        "equipMultUnarmed": { "type": "number" },
        "equipMultStaff": { "type": "number" },
        "avoidThreatChance": { "type": "number" },
        "flags": { "type": "array", "items": { "type": "string" }, "description": "CombatStyle.Flag names, e.g. Dueling" }
      }
    },
    "package": {
      "type": "object",
      "required": ["editorId", "template"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "template": { "$ref": "#/$defs/ref", "description": "vanilla procedure template, e.g. Sandbox=Skyrim.esm:0x01C254, Travel=Skyrim.esm:0x016FAA" },
        "flags": { "type": "array", "items": { "type": "string" }, "description": "Package.Flag names" },
        "interruptFlags": { "type": "array", "items": { "type": "string" }, "description": "HellosToPlayer / AllowIdleChatter / WorldInteractions / ..." },
        "preferredSpeed": { "enum": ["Walk", "Jog", "Run", "FastWalk"] },
        "combatStyle": { "$ref": "#/$defs/ref" },
        "ownerQuest": { "$ref": "#/$defs/ref" },
        "schedule": { "type": "object", "description": "{ month, dayOfWeek, date, hour, minute, durationInMinutes }" },
        "sandbox": { "type": "object", "description": "Sandbox template inputs (radius, allowEating, ...); see SPEC.md" },
        "travel": { "type": "object", "description": "Travel template inputs (destination, ...); see SPEC.md" },
        "useMagic": { "type": "object", "description": "UseMagic template inputs (spell, numToCastMax, ...); see SPEC.md" }
      }
    },
    "quest": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "dialogue": {
      "type": "object",
      "required": ["editorId", "questEditorId", "prompt"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "questEditorId": { "type": "string", "minLength": 1, "description": "must be a quest editorId in this spec" },
        "speakerNpcEditorId": { "type": "string", "description": "optional; an npc editorId (GetIsID condition). The speaker also needs a `greeting` so it is conversable" },
        "prompt": { "type": "string", "minLength": 1, "description": "the player's topic line" },
        "responses": { "type": "array", "items": { "type": "string" }, "description": "the NPC's spoken lines" },
        "emotion": { "enum": ["Neutral", "Anger", "Disgust", "Fear", "Sad", "Happy", "Surprise"], "description": "applied to all response lines (default Neutral)" },
        "emotionValue": { "type": "integer", "minimum": 0, "maximum": 100, "description": "emotion intensity (default 50)" }
      }
    },
    "script": {
      "type": "object",
      "required": ["targetEditorId", "scriptName"],
      "properties": {
        "targetEditorId": { "type": "string", "minLength": 1, "description": "record to attach to (any editorId)" },
        "scriptName": { "type": "string", "minLength": 1, "description": "must match the .pex/.psc Scriptname" },
        "source": { "type": "string", "description": "optional .psc path (rel. to spec); `package` compiles it" },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } }
      }
    },
    "property": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["int", "float", "bool", "string", "object"] },
        "int": { "type": "integer" },
        "float": { "type": "number" },
        "bool": { "type": "boolean" },
        "str": { "type": "string" },
        "objectEditorId": { "type": "string", "description": "required when type=object; an editorId" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "object" } } },
          "then": { "required": ["objectEditorId"] } }
      ]
    },
    "cell": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "description": "display name" },
        "template": { "type": "string", "description": "optional vanilla INTERIOR cell '<master>:0xFORMID' to copy lighting/water env from (a new cell with no lighting renders BLACK; find one with `find <Skyrim.esm> <name> Cell`). Still place a floor static via a `placement`, else the player falls into the void." }
      }
    },
    "vec3": {
      "type": "object",
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }
      }
    },
    "placement": {
      "type": "object",
      "required": ["base"],
      "description": "set EITHER `cell` (interior) OR `worldspace` (exterior); worldspace wins if both are set",
      "oneOf": [
        { "required": ["cell"] },
        { "required": ["worldspace"] }
      ],
      "properties": {
        "base": { "$ref": "#/$defs/ref", "description": "the form to place: an in-spec npc/object editorId or external <master>:0xFORMID" },
        "cell": { "type": "string", "minLength": 1, "description": "INTERIOR target: an in-spec cell editorId OR a vanilla INTERIOR cell '<master>:0xFORMID' (find with `find <Skyrim.esm> <name> Cell`)" },
        "worldspace": { "type": "string", "minLength": 1, "description": "EXTERIOR target: a worldspace '<master>:0xFORMID' (Tamriel = Skyrim.esm:0x00003C; find with `find <Skyrim.esm> <name> Worldspace`). `position` is then WORLD coords; the cell at floor(x/4096),floor(y/4096) is overridden" },
        "kind": { "enum": ["npc", "object"], "description": "inferred for in-spec bases; defaults to object for external" },
        "position": { "$ref": "#/$defs/vec3", "description": "cell-local for interior; WORLD coords for exterior" },
        "rotation": { "$ref": "#/$defs/vec3", "description": "degrees" },
        "persistent": { "type": "boolean", "description": "place in the cell's persistent (vs temporary) list" }
      }
    },
    "leveledEntry": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": { "$ref": "#/$defs/ref", "description": "the item (LVLI) or npc (LVLN) to spawn — in-spec or external" },
        "level": { "type": "integer", "minimum": 1, "description": "min player/encounter level for this entry (default 1)" },
        "count": { "type": "integer", "minimum": 1, "description": "how many (default 1)" }
      }
    },
    "leveledList": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "chanceNone": { "type": "integer", "minimum": 0, "maximum": 100, "description": "percent chance the list yields nothing" },
        "flags": { "type": "array", "items": { "enum": ["CalculateFromAllLevelsLessThanOrEqualPlayer", "CalculateForEachItemInCount", "UseAll", "SpecialLoot"] } },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/leveledEntry" } }
      }
    },
    "containerItem": {
      "type": "object",
      "required": ["item"],
      "properties": {
        "item": { "$ref": "#/$defs/ref", "description": "the item to put inside — in-spec or external" },
        "count": { "type": "integer", "minimum": 1, "description": "default 1" }
      }
    },
    "container": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "weight": { "type": "number", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/containerItem" } }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["editorId", "createdObject"],
      "description": "ConstructibleObject (COBJ): a crafting recipe",
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["craft", "temper", "smelt", "breakdown"], "default": "craft", "description": "recipe flavour; picks the default bench (craft->forge, temper->sharpening wheel, smelt/breakdown->smelter)" },
        "createdObject": { "$ref": "#/$defs/ref", "description": "the item produced (temper: the item being improved) — usually an in-spec weapon/armor/etc." },
        "count": { "type": "integer", "minimum": 1, "description": "how many are produced (default 1)" },
        "workbench": { "type": "string", "description": "named selector (forge|sharpeningWheel|armorTable|smelter|tanningRack|skyforge) OR a keyword ref; omit -> the kind default" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/containerItem" }, "description": "ingredients consumed on craft (item ref + count)" },
        "conditions": {
          "type": "array",
          "description": "perk/item/skill gating (shared CTDA ConditionSpec)",
          "items": {
            "type": "object",
            "properties": {
              "function": { "enum": ["HasPerk", "GetItemCount", "GetGlobalValue", "TemperIsEnchanted"], "description": "the CTDA function; HasPerk/GetItemCount/GetGlobalValue need a param, TemperIsEnchanted does not" },
              "param": { "type": "string", "description": "the function's form arg (perk/item/global ref)" },
              "comparison": { "enum": ["==", "=", "!=", ">", ">=", "<", "<="], "description": "the comparison operator (default >=)" },
              "value": { "type": "number", "description": "the test value (default 0)" },
              "or": { "type": "boolean", "description": "OR-chain with the NEXT condition (default AND)" }
            }
          }
        }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "ammunition": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "damage": { "type": "number", "minimum": 0 },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "scroll": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "spellType": { "enum": ["Spell", "Disease", "Power", "LesserPower", "Ability", "Poison", "Addiction", "Voice"] },
        "castType": { "enum": ["ConstantEffect", "FireAndForget", "Concentration"] },
        "targetType": { "enum": ["Self", "Touch", "Aimed", "TargetActor", "TargetLocation"] },
        "baseCost": { "type": "integer", "minimum": 0 },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "soulGem": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "maximumCapacity": { "enum": ["None", "Petty", "Lesser", "Common", "Greater", "Grand"] },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "key": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "keyword": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1, "description": "reference it from any record's `keywords` list" }
      }
    },
    "outfit": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "armor/weapon refs the NPC wears; an npc `outfit` can point at this editorId" }
      }
    },
    "staticRec": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "description": "a .nif path (reference a vanilla mesh in the BSA, e.g. 'Clutter\\\\Common\\\\Rock01.nif')" }
      }
    },
    "activator": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "model": { "type": "string", "description": "a .nif path" },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    }
  }
}
