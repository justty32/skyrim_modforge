{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modforge/spec.schema.json",
  "title": "ModForge plugin spec",
  "description": "Describes the content of one Skyrim plugin. See SPEC.md. Property names are matched case-insensitively by the generator.",
  "type": "object",
  "properties": {
    "pluginName": { "type": "string", "description": "Output filename / ModKey, e.g. MyMod.esp" },
    "esl": { "type": "boolean", "default": true, "description": "Light-master flag; keep new records <= 4096" },
    "miscItems": { "type": "array", "items": { "$ref": "#/$defs/named" } },
    "books": { "type": "array", "items": { "$ref": "#/$defs/book" } },
    "weapons": { "type": "array", "items": { "$ref": "#/$defs/weapon" } },
    "npcs": { "type": "array", "items": { "$ref": "#/$defs/npc" } },
    "quests": { "type": "array", "items": { "$ref": "#/$defs/quest" } },
    "dialogue": { "type": "array", "items": { "$ref": "#/$defs/dialogue" } },
    "spells": { "type": "array", "items": { "$ref": "#/$defs/spell" } },
    "potions": { "type": "array", "items": { "$ref": "#/$defs/potion" } },
    "armors": { "type": "array", "items": { "$ref": "#/$defs/armor" } },
    "factions": { "type": "array", "items": { "$ref": "#/$defs/named" } },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "scripts": { "type": "array", "items": { "$ref": "#/$defs/script" } },
    "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" }, "description": "new interior cells (reach in-game via `coc <editorId>`)" },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placement" }, "description": "put a base form into a cell at a position/rotation" }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "description": "A reference: an in-spec editorId OR an external form '<master>:0xFORMID' (e.g. 'Skyrim.esm:0x013746' = NordRace). Discover FormIDs with the `find` command."
    },
    "effect": {
      "type": "object",
      "required": ["magicEffect"],
      "properties": {
        "magicEffect": { "$ref": "#/$defs/ref", "description": "MagicEffect ref — normally a vanilla one, e.g. 'Skyrim.esm:0x03EB15' = AlchRestoreHealth. find <Skyrim.esm> <query> MagicEffect" },
        "magnitude": { "type": "number", "minimum": 0 },
        "area": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 0, "description": "seconds; 0 = instant" }
      }
    },
    "weapon": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "damage": { "type": "integer", "minimum": 0, "description": "base damage; functional weapon needs this > 0" },
        "speed": { "type": "number", "minimum": 0, "description": "swing speed (~1.0 normal); defaults to 1.0 if any stat is set" },
        "reach": { "type": "number", "minimum": 0, "description": "reach (~1.0 normal); defaults to 1.0 if any stat is set" },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "spell": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" }, "description": "magic effects (does nothing without at least one)" }
      }
    },
    "potion": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" }, "description": "magic effects (a potion is fully functional with one)" }
      }
    },
    "named": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "keyword refs (weapons/misc; ignored on records that don't take keywords)" }
      }
    },
    "book": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "armor": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "armorRating": { "type": "number", "minimum": 0 },
        "armorType": { "enum": ["light", "heavy", "clothing", "lightArmor", "heavyArmor"], "description": "armor class; default clothing" },
        "slots": { "type": "array", "items": { "type": "string" }, "description": "biped slots occupied, e.g. Body, Head, Hands, Feet, Forearms, Calves, Shield (BipedObjectFlag names)" },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "message": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "npc": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "factions": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "faction refs (in-spec or external)" },
        "race": { "$ref": "#/$defs/ref", "description": "Race ref; needed (with class) for a functional actor" },
        "class": { "$ref": "#/$defs/ref", "description": "Class ref" },
        "outfit": { "$ref": "#/$defs/ref", "description": "Outfit ref -> DefaultOutfit" }
      }
    },
    "quest": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "dialogue": {
      "type": "object",
      "required": ["editorId", "questEditorId", "prompt"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "questEditorId": { "type": "string", "minLength": 1, "description": "must be a quest editorId in this spec" },
        "speakerNpcEditorId": { "type": "string", "description": "optional; an npc editorId (GetIsID condition)" },
        "prompt": { "type": "string", "minLength": 1, "description": "the player's topic line" },
        "responses": { "type": "array", "items": { "type": "string" }, "description": "the NPC's spoken lines" }
      }
    },
    "script": {
      "type": "object",
      "required": ["targetEditorId", "scriptName"],
      "properties": {
        "targetEditorId": { "type": "string", "minLength": 1, "description": "record to attach to (any editorId)" },
        "scriptName": { "type": "string", "minLength": 1, "description": "must match the .pex/.psc Scriptname" },
        "source": { "type": "string", "description": "optional .psc path (rel. to spec); `package` compiles it" },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } }
      }
    },
    "property": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["int", "float", "bool", "string", "object"] },
        "int": { "type": "integer" },
        "float": { "type": "number" },
        "bool": { "type": "boolean" },
        "str": { "type": "string" },
        "objectEditorId": { "type": "string", "description": "required when type=object; an editorId" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "object" } } },
          "then": { "required": ["objectEditorId"] } }
      ]
    },
    "cell": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "description": "display name" }
      }
    },
    "vec3": {
      "type": "object",
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }
      }
    },
    "placement": {
      "type": "object",
      "required": ["base", "cell"],
      "properties": {
        "base": { "$ref": "#/$defs/ref", "description": "the form to place: an in-spec npc/object editorId or external <master>:0xFORMID" },
        "cell": { "type": "string", "minLength": 1, "description": "an in-spec cell editorId (placing into a vanilla cell is not supported yet)" },
        "kind": { "enum": ["npc", "object"], "description": "inferred for in-spec bases; defaults to object for external" },
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/vec3", "description": "degrees" },
        "persistent": { "type": "boolean", "description": "place in the cell's persistent (vs temporary) list" }
      }
    }
  }
}
