{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modforge/spec.schema.json",
  "title": "ModForge plugin spec",
  "description": "Describes the content of one Skyrim plugin. See SPEC.md. Property names are matched case-insensitively by the generator.",
  "type": "object",
  "properties": {
    "pluginName": { "type": "string", "description": "Output filename / ModKey, e.g. MyMod.esp" },
    "esl": { "type": "boolean", "default": true, "description": "Light-master flag; keep new records <= 4096" },
    "miscItems": { "type": "array", "items": { "$ref": "#/$defs/named" } },
    "books": { "type": "array", "items": { "$ref": "#/$defs/book" } },
    "weapons": { "type": "array", "items": { "$ref": "#/$defs/weapon" } },
    "npcs": { "type": "array", "items": { "$ref": "#/$defs/npc" } },
    "quests": { "type": "array", "items": { "$ref": "#/$defs/quest" } },
    "dialogue": { "type": "array", "items": { "$ref": "#/$defs/dialogue" } },
    "spells": { "type": "array", "items": { "$ref": "#/$defs/spell" } },
    "potions": { "type": "array", "items": { "$ref": "#/$defs/potion" } },
    "armors": { "type": "array", "items": { "$ref": "#/$defs/armor" } },
    "factions": { "type": "array", "items": { "$ref": "#/$defs/named" } },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "scripts": { "type": "array", "items": { "$ref": "#/$defs/script" } },
    "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" }, "description": "new interior cells (reach in-game via `coc <editorId>`)" },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placement" }, "description": "put a base form into a cell at a position/rotation" },
    "leveledItems": { "type": "array", "items": { "$ref": "#/$defs/leveledList" }, "description": "LeveledItem (LVLI): level-gated weighted item lists" },
    "leveledNpcs": { "type": "array", "items": { "$ref": "#/$defs/leveledList" }, "description": "LeveledNpc (LVLN): level-gated weighted npc lists" },
    "containers": { "type": "array", "items": { "$ref": "#/$defs/container" }, "description": "Container (CONT): a named container with item contents" },
    "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" }, "description": "Ingredient (INGR): alchemy reagent with effects" },
    "ammunitions": { "type": "array", "items": { "$ref": "#/$defs/ammunition" }, "description": "Ammunition (AMMO): arrow/bolt with damage" },
    "scrolls": { "type": "array", "items": { "$ref": "#/$defs/scroll" }, "description": "Scroll (SCRL): one-shot spell-as-item with effects + cast fields" },
    "soulGems": { "type": "array", "items": { "$ref": "#/$defs/soulGem" }, "description": "SoulGem (SLGM)" },
    "keys": { "type": "array", "items": { "$ref": "#/$defs/key" }, "description": "Key (KEYM)" },
    "keywords": { "type": "array", "items": { "$ref": "#/$defs/keyword" }, "description": "Keyword (KYWD): define your own so in-spec records can reference it" },
    "outfits": { "type": "array", "items": { "$ref": "#/$defs/outfit" }, "description": "Outfit (OTFT): a set of item refs an NPC can wear" },
    "statics": { "type": "array", "items": { "$ref": "#/$defs/staticRec" }, "description": "Static (STAT): a world mesh (model path)" },
    "activators": { "type": "array", "items": { "$ref": "#/$defs/activator" }, "description": "Activator (ACTI): an interactable world object" }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "description": "A reference: an in-spec editorId OR an external form '<master>:0xFORMID' (e.g. 'Skyrim.esm:0x013746' = NordRace). Discover FormIDs with the `find` command."
    },
    "effect": {
      "type": "object",
      "required": ["magicEffect"],
      "properties": {
        "magicEffect": { "$ref": "#/$defs/ref", "description": "MagicEffect ref — normally a vanilla one, e.g. 'Skyrim.esm:0x03EB15' = AlchRestoreHealth. find <Skyrim.esm> <query> MagicEffect" },
        "magnitude": { "type": "number", "minimum": 0 },
        "area": { "type": "integer", "minimum": 0 },
        "duration": { "type": "integer", "minimum": 0, "description": "seconds; 0 = instant" }
      }
    },
    "weapon": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "damage": { "type": "integer", "minimum": 0, "description": "base damage; functional weapon needs this > 0" },
        "speed": { "type": "number", "minimum": 0, "description": "swing speed (~1.0 normal); defaults to 1.0 if any stat is set" },
        "reach": { "type": "number", "minimum": 0, "description": "reach (~1.0 normal); defaults to 1.0 if any stat is set" },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "spell": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" }, "description": "magic effects (does nothing without at least one)" },
        "spellType": { "enum": ["Spell", "Disease", "Power", "LesserPower", "Ability", "Poison", "Addiction", "Voice"] },
        "castType": { "enum": ["ConstantEffect", "FireAndForget", "Concentration"] },
        "targetType": { "enum": ["Self", "Touch", "Aimed", "TargetActor", "TargetLocation"] },
        "baseCost": { "type": "integer", "minimum": 0, "description": "magicka cost" },
        "chargeTime": { "type": "number", "minimum": 0 }
      }
    },
    "potion": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" }, "description": "magic effects (a potion is fully functional with one)" }
      }
    },
    "named": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "keyword refs (weapons/misc; ignored on records that don't take keywords)" }
      }
    },
    "book": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "armor": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "armorRating": { "type": "number", "minimum": 0 },
        "armorType": { "enum": ["light", "heavy", "clothing", "lightArmor", "heavyArmor"], "description": "armor class; default clothing" },
        "slots": { "type": "array", "items": { "type": "string" }, "description": "biped slots occupied, e.g. Body, Head, Hands, Feet, Forearms, Calves, Shield (BipedObjectFlag names)" },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "message": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "npc": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "factions": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "faction refs (in-spec or external)" },
        "race": { "$ref": "#/$defs/ref", "description": "Race ref; needed (with class) for a functional actor" },
        "class": { "$ref": "#/$defs/ref", "description": "Class ref" },
        "outfit": { "$ref": "#/$defs/ref", "description": "Outfit ref -> DefaultOutfit" }
      }
    },
    "quest": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "dialogue": {
      "type": "object",
      "required": ["editorId", "questEditorId", "prompt"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "questEditorId": { "type": "string", "minLength": 1, "description": "must be a quest editorId in this spec" },
        "speakerNpcEditorId": { "type": "string", "description": "optional; an npc editorId (GetIsID condition)" },
        "prompt": { "type": "string", "minLength": 1, "description": "the player's topic line" },
        "responses": { "type": "array", "items": { "type": "string" }, "description": "the NPC's spoken lines" }
      }
    },
    "script": {
      "type": "object",
      "required": ["targetEditorId", "scriptName"],
      "properties": {
        "targetEditorId": { "type": "string", "minLength": 1, "description": "record to attach to (any editorId)" },
        "scriptName": { "type": "string", "minLength": 1, "description": "must match the .pex/.psc Scriptname" },
        "source": { "type": "string", "description": "optional .psc path (rel. to spec); `package` compiles it" },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } }
      }
    },
    "property": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["int", "float", "bool", "string", "object"] },
        "int": { "type": "integer" },
        "float": { "type": "number" },
        "bool": { "type": "boolean" },
        "str": { "type": "string" },
        "objectEditorId": { "type": "string", "description": "required when type=object; an editorId" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "object" } } },
          "then": { "required": ["objectEditorId"] } }
      ]
    },
    "cell": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "description": "display name" },
        "template": { "type": "string", "description": "optional vanilla INTERIOR cell '<master>:0xFORMID' to copy lighting/water env from (a new cell with no lighting renders BLACK; find one with `find <Skyrim.esm> <name> Cell`). Still place a floor static via a `placement`, else the player falls into the void." }
      }
    },
    "vec3": {
      "type": "object",
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" }
      }
    },
    "placement": {
      "type": "object",
      "required": ["base"],
      "description": "set EITHER `cell` (interior) OR `worldspace` (exterior); worldspace wins if both are set",
      "oneOf": [
        { "required": ["cell"] },
        { "required": ["worldspace"] }
      ],
      "properties": {
        "base": { "$ref": "#/$defs/ref", "description": "the form to place: an in-spec npc/object editorId or external <master>:0xFORMID" },
        "cell": { "type": "string", "minLength": 1, "description": "INTERIOR target: an in-spec cell editorId OR a vanilla INTERIOR cell '<master>:0xFORMID' (find with `find <Skyrim.esm> <name> Cell`)" },
        "worldspace": { "type": "string", "minLength": 1, "description": "EXTERIOR target: a worldspace '<master>:0xFORMID' (Tamriel = Skyrim.esm:0x00003C; find with `find <Skyrim.esm> <name> Worldspace`). `position` is then WORLD coords; the cell at floor(x/4096),floor(y/4096) is overridden" },
        "kind": { "enum": ["npc", "object"], "description": "inferred for in-spec bases; defaults to object for external" },
        "position": { "$ref": "#/$defs/vec3", "description": "cell-local for interior; WORLD coords for exterior" },
        "rotation": { "$ref": "#/$defs/vec3", "description": "degrees" },
        "persistent": { "type": "boolean", "description": "place in the cell's persistent (vs temporary) list" }
      }
    },
    "leveledEntry": {
      "type": "object",
      "required": ["reference"],
      "properties": {
        "reference": { "$ref": "#/$defs/ref", "description": "the item (LVLI) or npc (LVLN) to spawn — in-spec or external" },
        "level": { "type": "integer", "minimum": 1, "description": "min player/encounter level for this entry (default 1)" },
        "count": { "type": "integer", "minimum": 1, "description": "how many (default 1)" }
      }
    },
    "leveledList": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "chanceNone": { "type": "integer", "minimum": 0, "maximum": 100, "description": "percent chance the list yields nothing" },
        "flags": { "type": "array", "items": { "enum": ["CalculateFromAllLevelsLessThanOrEqualPlayer", "CalculateForEachItemInCount", "UseAll", "SpecialLoot"] } },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/leveledEntry" } }
      }
    },
    "containerItem": {
      "type": "object",
      "required": ["item"],
      "properties": {
        "item": { "$ref": "#/$defs/ref", "description": "the item to put inside — in-spec or external" },
        "count": { "type": "integer", "minimum": 1, "description": "default 1" }
      }
    },
    "container": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "weight": { "type": "number", "minimum": 0 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/containerItem" } }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "ammunition": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "damage": { "type": "number", "minimum": 0 },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "scroll": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "spellType": { "enum": ["Spell", "Disease", "Power", "LesserPower", "Ability", "Poison", "Addiction", "Voice"] },
        "castType": { "enum": ["ConstantEffect", "FireAndForget", "Concentration"] },
        "targetType": { "enum": ["Self", "Touch", "Aimed", "TargetActor", "TargetLocation"] },
        "baseCost": { "type": "integer", "minimum": 0 },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "soulGem": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "maximumCapacity": { "enum": ["None", "Petty", "Lesser", "Common", "Greater", "Grand"] },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "key": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number", "minimum": 0 },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "keyword": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1, "description": "reference it from any record's `keywords` list" }
      }
    },
    "outfit": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "description": "armor/weapon refs the NPC wears; an npc `outfit` can point at this editorId" }
      }
    },
    "staticRec": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "description": "a .nif path (reference a vanilla mesh in the BSA, e.g. 'Clutter\\\\Common\\\\Rock01.nif')" }
      }
    },
    "activator": {
      "type": "object",
      "required": ["editorId"],
      "properties": {
        "editorId": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "model": { "type": "string", "description": "a .nif path" },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    }
  }
}
