      "questEditorId": "MFSofVigAct1Controller",
      "topLevel": false,
      "prompt": "You were worried about me, weren't you.",
      "responses": [
        "Worried? I was calculating how much of your gear I could carry if you died. ...Sixty-three breaths. I'm just saying. Nobody counts sixty-three breaths about someone they don't care about. Shut up. Keep moving."
      ],
      "goodbye": true,
      "conditions": [
