    {
      "editorId": "MFSofVig_1G_WitchDoubtMore",
      "questEditorId": "MFSofVigAct1Controller",
      "topLevel": false,
      "prompt": "Since when do you defend witches?",
      "responses": [
        "I'm not defending witches. I hate being used as a blunt instrument. When someone points at a person and says 'monster, go kill' and the person looks nothing like a monster... usually the real monster is the one giving the order. I've been on the other side of that enough times to know."
      ],
      "goodbye": true,
      "conditions": [
        {
          "function": "GetIsID",
          "param": "SofiaFollower.esp:0x0012C4",
          "comparison": "==",
          "value": 1
