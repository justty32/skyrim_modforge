{
  "pluginName": "ModForgeSkillTree.esp",
  "esl": true,

  "_comment": "Idea #20 Phase 1 (STANDALONE, ZERO external-mod dependency) — a self-contained in-world skill tree that needs NEITHER Campfire NOR Frostfall, only Skyrim.esm. Instead of Campfire's spawn-at-campfire radial menu, this is the most literal in-world tree: 3 floating crystal 'nodes' placed in a small custom room you walk into and click. Each node runs our OWN tiny Papyrus script (MFSkillNode.psc, vanilla types only) — click -> gate-check (prerequisite node + points) -> grant a custom Fortify ability + spend a point. Vertical chain: Forged Resolve (root, always available) -> Forged Vigor -> Forged Mastery. TEST: `coc MFSkillTreeRoom`, look around for the 3 glowing crystals, click the lowest one. See docs in wait_todo/ingame-tests.md.",

  "globals": [
    { "editorId": "MFSkill_PointsAvail", "type": "short", "value": 3, "_": "shared point pool; starts at 3 so you can buy all three immediately for the test" },
    { "editorId": "MFSkill_N0_Rank", "type": "short", "value": 0 },
    { "editorId": "MFSkill_N1_Rank", "type": "short", "value": 0 },
    { "editorId": "MFSkill_N2_Rank", "type": "short", "value": 0 }
  ],

  "magicEffects": [
    { "editorId": "MFSkill_FortifyHealthEff",  "name": "Forged Resolve",
      "description": "Your body is hardened. Fortifies Health.",
      "archetype": "ValueModifier", "actorValue": "Health",
      "castType": "ConstantEffect", "targetType": "Self", "baseCost": 0 },
    { "editorId": "MFSkill_FortifyStaminaEff", "name": "Forged Vigor",
      "description": "Your endurance deepens. Fortifies Stamina.",
      "archetype": "ValueModifier", "actorValue": "Stamina",
      "castType": "ConstantEffect", "targetType": "Self", "baseCost": 0 },
    { "editorId": "MFSkill_FortifyCarryEff",   "name": "Forged Mastery",
      "description": "You bear more with ease. Fortifies Carry Weight.",
      "archetype": "ValueModifier", "actorValue": "CarryWeight",
      "castType": "ConstantEffect", "targetType": "Self", "baseCost": 0 }
  ],

  "spells": [
    { "editorId": "MFSkill_Node0Ability", "name": "Forged Resolve", "spellType": "Ability",
      "castType": "ConstantEffect", "targetType": "Self",
