{
  "pluginName": "ModForgeSkillTree.esp",
  "esl": true,

  "_comment": "Idea #20 Phase 1 — PLAYER-version in-world 3D skill tree, hand-authored to VALIDATE the Campfire skill-tree pipeline end-to-end before writing the `skillTree:` generator (Phase 3). Mirrors Frostfall's working Endurance tree (decoded from Frostfall.esp 064026 + Campfire 1.11SE .psc source). DEPENDS ON Campfire.esm (master auto-added from the Campfire.esm:0xID refs below); the three tree scripts (CampPerkNode / CampPerkNodeControllerBehavior / CampPerkSystemRegister) ship COMPILED in Campfire.bsa, so ModForge only attaches their VMAD by name + binds properties — NO .pex compilation needed. In-game: load with Campfire+Frostfall active, light a campfire, choose Skills, page (Next/Prev bug) to 'ModForge Test Tree', click the bottom star to spend a point. 3-node vertical chain: Resolve(root, always buyable) -> Vigor -> Mastery.",

  "globals": [
    { "editorId": "MFSkill_PointsAvail",  "type": "short", "value": 3, "_": "required_perk_points_available — TEST: player starts with 3 points to spend immediately (real tree would earn these via gameplay)" },
    { "editorId": "MFSkill_PointProgress", "type": "float", "value": 0, "_": "required_perk_point_progress (0..1) — progress toward next point; cosmetic for the test" },

    { "editorId": "MFSkill_N0_Rank",    "type": "short", "value": 0, "_": "Resolve current rank" },
    { "editorId": "MFSkill_N0_RankMax", "type": "short", "value": 1 },
    { "editorId": "MFSkill_N1_Rank",    "type": "short", "value": 0, "_": "Vigor current rank" },
    { "editorId": "MFSkill_N1_RankMax", "type": "short", "value": 1 },
    { "editorId": "MFSkill_N2_Rank",    "type": "short", "value": 0, "_": "Mastery current rank" },
    { "editorId": "MFSkill_N2_RankMax", "type": "short", "value": 1 }
  ],

  "messages": [
    { "editorId": "MFSkill_SkillDesc", "name": "ModForge Test Tree",
      "description": "MODFORGE TEST TREE\n\nA proof-of-concept in-world skill tree generated by ModForge. Activate a star to spend a perk point. Buying a node unlocks the next one up the chain.\n\nPoints to spend: %.0f\nNext perk progress: %.0f%%",
      "_": "required_skill_description (shared by all nodes). Campfire calls .Show(points, progress*100); the two %.0f tokens fill those." },

    { "editorId": "MFSkill_N0_Desc", "name": "Forged Resolve",
      "description": "FORGED RESOLVE\n\nThe root node of the ModForge test tree. Always available. Buy it first to unlock the rest of the chain." },
    { "editorId": "MFSkill_N1_Desc", "name": "Forged Vigor",
      "description": "FORGED VIGOR\n\nThe second node. Unlocks once Forged Resolve is purchased." },
    { "editorId": "MFSkill_N2_Desc", "name": "Forged Mastery",
      "description": "FORGED MASTERY\n\nThe top node. Unlocks once Forged Vigor is purchased." }
  ],

  "statics": [
    { "editorId": "MFSkill_ArtPlane", "model": "campfire\\_camp_perkartplane.nif",
      "_": "the dark backdrop panel behind the stars (reuses Campfire's mesh from Campfire.bsa)" }
  ],

  "activators": [
    { "editorId": "MFSkill_Node0", "name": "Forged Resolve", "model": "campfire\\_camp_intperkstars01.nif" },
    { "editorId": "MFSkill_Node1", "name": "Forged Vigor",   "model": "campfire\\_camp_intperkstars01.nif" },
    { "editorId": "MFSkill_Node2", "name": "Forged Mastery", "model": "campfire\\_camp_intperkstars01.nif" },

    { "editorId": "MFSkill_Line01", "model": "campfire\\_camp_intperkline01.nif", "_": "connector Resolve->Vigor (scriptless; plays Unlock anim)" },
    { "editorId": "MFSkill_Line12", "model": "campfire\\_camp_intperkline01.nif", "_": "connector Vigor->Mastery" },

    { "editorId": "MFSkill_Controller", "model": "MarkerX.nif", "_": "invisible controller anchor; Campfire PlaceAtMe's this at the campfire then it spawns the nodes/lines/plane around itself" }
  ],

  "cells": [
    { "editorId": "MFSkillTreeLayoutCell", "name": "ModForge Skill Tree Layout",
      "_": "an unvisited interior cell that just HOLDS the PositionRef layout markers. The placement system reads each marker's offset from the center marker and replicates the tree at the campfire at runtime; the cell itself is never entered." }
  ],

  "placements": [
    { "editorId": "MFSkill_PosRef_Center", "kind": "xmarker", "persistent": true,
      "cell": "MFSkillTreeLayoutCell", "position": { "x": 0, "y": 0, "z": 200 },
      "_": "PerkNodeController_PositionRef = CenterObject; all offsets are computed relative to this" },

    { "editorId": "MFSkill_PosRef_Node0", "base": "Campfire.esm:0x043811", "persistent": true,
      "cell": "MFSkillTreeLayoutCell", "position": { "x": 0, "y": -60, "z": 252 }, "_": "root star, +52 up, 60 toward player" },
    { "editorId": "MFSkill_PosRef_Node1", "base": "Campfire.esm:0x043811", "persistent": true,
      "cell": "MFSkillTreeLayoutCell", "position": { "x": 0, "y": -60, "z": 304 } },
    { "editorId": "MFSkill_PosRef_Node2", "base": "Campfire.esm:0x043811", "persistent": true,
      "cell": "MFSkillTreeLayoutCell", "position": { "x": 0, "y": -60, "z": 356 } },

    { "editorId": "MFSkill_PosRef_Line01", "base": "Campfire.esm:0x043832", "persistent": true,
      "cell": "MFSkillTreeLayoutCell", "position": { "x": 0, "y": -60, "z": 278 }, "rotation": { "x": 90, "y": 0, "z": 180 },
      "_": "midpoint between node0 and node1; rot pitch 90 + yaw 180 = vertical connector (mirrors Frostfall's vertical lines)" },
    { "editorId": "MFSkill_PosRef_Line12", "base": "Campfire.esm:0x043832", "persistent": true,
      "cell": "MFSkillTreeLayoutCell", "position": { "x": 0, "y": -60, "z": 330 }, "rotation": { "x": 90, "y": 0, "z": 180 } },

    { "editorId": "MFSkill_PosRef_ArtPlane", "base": "Campfire.esm:0x043811", "persistent": true,
      "cell": "MFSkillTreeLayoutCell", "position": { "x": 0, "y": -47, "z": 304 }, "_": "backdrop sits just behind the stars, centered on the middle node" }
  ],

  "scripts": [
    {
      "targetEditorId": "MFSkill_Node0",
      "scriptName": "CampPerkNode",
      "properties": [
        { "name": "required_perk_rank_global",     "type": "object", "objectEditorId": "MFSkill_N0_Rank" },
        { "name": "required_perk_rank_global_max", "type": "object", "objectEditorId": "MFSkill_N0_RankMax" },
        { "name": "required_perk_description",     "type": "object", "objectEditorId": "MFSkill_N0_Desc" },
        { "name": "required_skill_description",    "type": "object", "objectEditorId": "MFSkill_SkillDesc" },
        { "name": "required_description_value_count", "type": "int", "int": 0 }
      ],
      "_": "ROOT node — no downstream_node => the gate treats it as a starting node (always buyable)"
    },
    {
      "targetEditorId": "MFSkill_Node1",
      "scriptName": "CampPerkNode",
      "properties": [
        { "name": "required_perk_rank_global",     "type": "object", "objectEditorId": "MFSkill_N1_Rank" },
        { "name": "required_perk_rank_global_max", "type": "object", "objectEditorId": "MFSkill_N1_RankMax" },
        { "name": "required_perk_description",     "type": "object", "objectEditorId": "MFSkill_N1_Desc" },
        { "name": "required_skill_description",    "type": "object", "objectEditorId": "MFSkill_SkillDesc" },
        { "name": "required_description_value_count", "type": "int", "int": 0 },
        { "name": "downstream_node_1", "type": "object", "objectEditorId": "MFSkill_Node0" },
        { "name": "downstream_line_1", "type": "object", "objectEditorId": "MFSkill_Line01" }
      ],
      "_": "downstream points toward the root: buyable once Node0 (its downstream child) is bought"
    },
    {
      "targetEditorId": "MFSkill_Node2",
      "scriptName": "CampPerkNode",
      "properties": [
        { "name": "required_perk_rank_global",     "type": "object", "objectEditorId": "MFSkill_N2_Rank" },
        { "name": "required_perk_rank_global_max", "type": "object", "objectEditorId": "MFSkill_N2_RankMax" },
        { "name": "required_perk_description",     "type": "object", "objectEditorId": "MFSkill_N2_Desc" },
        { "name": "required_skill_description",    "type": "object", "objectEditorId": "MFSkill_SkillDesc" },
        { "name": "required_description_value_count", "type": "int", "int": 0 },
        { "name": "downstream_node_1", "type": "object", "objectEditorId": "MFSkill_Node1" },
        { "name": "downstream_line_1", "type": "object", "objectEditorId": "MFSkill_Line12" }
      ]
    },
    {
      "targetEditorId": "MFSkill_Controller",
      "scriptName": "CampPerkNodeControllerBehavior",
      "_": "extends CampPerkNodeController; holds the 12 node + 12 line slots (only the used ones set), their PositionRef markers, the art plane, the center ref, and the points/progress globals + shared skill description + confirm message",
      "properties": [
        { "name": "PerkNode00", "type": "object", "objectEditorId": "MFSkill_Node0" },
        { "name": "PerkNode01", "type": "object", "objectEditorId": "MFSkill_Node1" },
        { "name": "PerkNode02", "type": "object", "objectEditorId": "MFSkill_Node2" },
        { "name": "PerkNode00_PositionRef", "type": "object", "objectEditorId": "MFSkill_PosRef_Node0" },
        { "name": "PerkNode01_PositionRef", "type": "object", "objectEditorId": "MFSkill_PosRef_Node1" },
        { "name": "PerkNode02_PositionRef", "type": "object", "objectEditorId": "MFSkill_PosRef_Node2" },

        { "name": "PerkLine00", "type": "object", "objectEditorId": "MFSkill_Line01" },
        { "name": "PerkLine01", "type": "object", "objectEditorId": "MFSkill_Line12" },
        { "name": "PerkLine00_PositionRef", "type": "object", "objectEditorId": "MFSkill_PosRef_Line01" },
        { "name": "PerkLine01_PositionRef", "type": "object", "objectEditorId": "MFSkill_PosRef_Line12" },

        { "name": "PerkArtPlane", "type": "object", "objectEditorId": "MFSkill_ArtPlane" },
        { "name": "PerkArtPlane_PositionRef", "type": "object", "objectEditorId": "MFSkill_PosRef_ArtPlane" },

        { "name": "PerkNodeController_PositionRef", "type": "object", "objectEditorId": "MFSkill_PosRef_Center" },

        { "name": "required_perk_points_available", "type": "object", "objectEditorId": "MFSkill_PointsAvail" },
        { "name": "required_perk_point_progress",   "type": "object", "objectEditorId": "MFSkill_PointProgress" },
        { "name": "required_skill_description",      "type": "object", "objectEditorId": "MFSkill_SkillDesc" },
        { "name": "_Camp_PerkGeneral_UpgradeVerify", "type": "object", "objectEditorId": "Campfire.esm:0x043826" }
      ]
    }
  ],

  "quests": [
    {
      "editorId": "MFSkillRegisterQuest",
      "name": "ModForge Skill Tree (system)",
      "startGameEnabled": true,
      "_": "the register quest: a StartGameEnabled holder whose player-filled alias runs CampPerkSystemRegister.OnInit, which calls CampUtil.RegisterPerkTree(controller, mod_name) once Campfire API >= 4 is loaded",
      "aliases": [
        {
          "name": "RegisterAlias",
          "fill": "forced:Skyrim.esm:0x000014",
          "script": "CampPerkSystemRegister",
          "scriptProperties": [
            { "name": "required_node_controller", "type": "object", "objectEditorId": "MFSkill_Controller" },
            { "name": "mod_name", "type": "string", "str": "ModForge Test Tree" }
          ]
        }
      ]
    }
  ]
}
