  "quests": [
    {
      "_": "The dialogue HOST quest. startGameEnabled (the default) makes it auto-run so the dialogue below is loaded and evaluated — the single most-missed requirement. No stages/aliases needed for plain conversation.",
      "editorId": "MF_TalkQuest",
      "name": "ModForge Conversation",
      "startGameEnabled": true,
      "priority": 50,
      "objectives": []
    },
    {
      "_": "Single host quest for all three topics. startGameEnabled (default) so it runs.",
      "editorId": "MF_ConvQuest",
      "name": "ModForge Conversation",
      "startGameEnabled": true,
      "priority": 50,
      "objectives": []
    },
    {
      "editorId": "MF_LifelikeQuest",
      "name": "ModForge Lifelike Conversation",
      "startGameEnabled": true,
      "priority": 50,
      "objectives": []
    }
  ],
  "dialogue": [
    {
      "_": "A player top-level topic. `prompt` is the clickable menu line; `responses` are what the NPC says back (subtitles), in order. speakerNpcEditorId adds the GetIsID == MF_TalkerNpc condition so the line is exclusive to him. The build wires Quest->Branch(TopLevel,Player)->Topic(Custom)->INFO(GetIsID).",
      "editorId": "MF_TalkAboutPlace",
      "questEditorId": "MF_TalkQuest",
      "speakerNpcEditorId": "MF_TalkerNpc",
      "prompt": "Tell me about this place.",
      "responses": [
        "Welcome, traveler. Everything you see here was forged on Linux.",
        "No Creation Kit, no Windows — just JSON and a stubborn modder."
      ]
    },
    {
      "editorId": "MF_ConvLore",
      "questEditorId": "MF_ConvQuest",
      "speakerNpcEditorId": "MF_ConvNpc",
      "prompt": "What's the history of this inn?",
      "emotion": "Neutral",
      "responses": [
        "The Sleeping Giant has stood here longer than any of us remember.",
        "Walls like these have heard a thousand secrets — and kept every one."
      ]
    },
    {
      "editorId": "MF_ConvJoke",
      "questEditorId": "MF_ConvQuest",
      "speakerNpcEditorId": "MF_ConvNpc",
      "prompt": "Tell me a joke.",
      "emotion": "Happy",
      "emotionValue": 90,
      "responses": [
        "Why did the dragon cross the Pale? To get to the OTHER shout!",
        "Ha! I'll be here all week, friend."
      ]
    },
    {
      "editorId": "MF_ConvBye",
      "questEditorId": "MF_ConvQuest",
      "speakerNpcEditorId": "MF_ConvNpc",
      "prompt": "I should be going.",
      "emotion": "Sad",
      "emotionValue": 60,
      "responses": [
        "Off already? The road's a lonely thing.",
        "Walk with the warmth of the hearth at your back, traveler."
      ]
    },
    {
      "editorId": "MF_LifelikeWho",
      "questEditorId": "MF_LifelikeQuest",
      "speakerNpcEditorId": "MF_LifelikeNpc",
      "prompt": "Who are you?",
      "emotion": "Neutral",
      "responses": [
        "Edda. I keep to myself and the warmth of this hearth.",
        "Cross me and you'll find the fire isn't only in the hearth."
      ]
    },
    {
      "editorId": "MF_LifelikeMagic",
      "questEditorId": "MF_LifelikeQuest",
      "speakerNpcEditorId": "MF_LifelikeNpc",
      "prompt": "Can you teach me magic?",
      "emotion": "Happy",
      "emotionValue": 70,
      "responses": [
        "Destruction is just respect, taught quickly.",
        "Watch your fingers, apprentice."
      ]
    }
  ],
  "packages": [
    {
      "editorId": "MF_InnSandbox",
      "_": "Inn-patron Sandbox — she stays in the inn, eats/sits/wanders/uses idle markers. Combat preempts this automatically when she's attacked, then she resumes when it's over.",
      "template": "Skyrim.esm:0x01C254",
      "interruptFlags": [
        "HellosToPlayer",
        "AllowIdleChatter",
        "WorldInteractions"
      ],
      "sandbox": {
        "radius": 512,
        "allowEating": true,
        "allowSleeping": false,
        "allowConversation": true,
        "allowIdleMarkers": true,
        "allowSitting": true,
        "allowWandering": true,
        "allowSpecialFurniture": true,
        "energy": 50.0
      }
    }
  ],
  "combatStyles": [
    {
      "editorId": "MF_GuardMageCS",
      "_": "Magic-favoring profile harvested via cstydiag (csVampireMagic-like): Magic dominates the equip weights so the AI picks her Flames spell over melee.",
