      ]
    }
  ],
  "relationships": [
    {
      "_": "Ally relationship to the player. parent = the follower; child = the Player NPC base (Skyrim.esm:0x000014 — NOT PlayerRef 0x000007, which is the placed ACHR; a RELA pointing at an ACHR is a type mismatch that CRASHES on load). This satisfies the DialogueFollower free-follow gate (GetRelationshipRank >= Ally).",
      "editorId": "MF_HireRel",
      "parent": "MF_HireFollowerNpc",
      "child": "Skyrim.esm:0x000014",
      "rank": "Ally"
    }
  ],
