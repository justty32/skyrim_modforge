      "defensiveMult": 0.3,
      "groupOffensiveMult": 0.74,
      "equipMultMelee": 0.51,
      "equipMultMagic": 8.1,
      "equipMultRanged": 0.55,
      "equipMultShout": 0.21,
      "equipMultUnarmed": 0.98,
      "equipMultStaff": 2.15,
      "avoidThreatChance": 0.2,
      "flags": [
