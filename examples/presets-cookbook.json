{
  "pluginName": "ModForgePresetsCookbook.esp",
  "esl": true,
  "_": "Preset/cookbook layer. `presets` is a non-emitting catalog for copy/paste fragments; the concrete top-level arrays below expand every preset once so this file validates and builds as a practical reference.",

  "presets": {
    "lighting": {
      "brightInterior": {
        "_": "Clean, readable interior fill. Copy the LGTM + IMGS into lightingTemplates/imageSpaces and attach them to a cell.",
        "lightingTemplate": "MF_PresetBrightInteriorLGTM",
        "imageSpace": "MF_PresetBrightInteriorIMGS"
      },
      "warmTavern": {
        "_": "Warm amber interior with mild bloom and short fog for inns, shops, and halls.",
        "lightingTemplate": "MF_PresetWarmTavernLGTM",
        "imageSpace": "MF_PresetWarmTavernIMGS"
      },
      "coldDungeon": {
        "_": "Blue-grey low-saturation dungeon light with pale fog and long falloff.",
        "lightingTemplate": "MF_PresetColdDungeonLGTM",
        "imageSpace": "MF_PresetColdDungeonIMGS"
      }
    },
    "weather": {
      "clearBright": {
        "_": "Clear vanilla sky base with brighter outdoor grade.",
        "weather": "MF_PresetClearBrightWeather",
        "climate": "MF_PresetClearBrightClimate"
      },
      "foggyPale": {
        "_": "Pale cloudy weather with close fog and desaturated image space.",
        "weather": "MF_PresetFoggyPaleWeather",
        "climate": "MF_PresetFoggyPaleClimate"
      },
      "stormCinematic": {
        "_": "Rainy storm base with strong contrast, wind, rain SPGD, and cinematic tint.",
        "weather": "MF_PresetStormCinematicWeather",
        "climate": "MF_PresetStormCinematicClimate"
      }
    },
    "packages": {
      "guardPost": {
        "_": "A guard holds a local post, talks, idles, and reacts to trouble without wandering far.",
        "package": "MF_PresetGuardPostPackage"
      },
      "wanderMerchant": {
        "_": "A merchant wanders a compact radius, offers service, greets, chats, and uses furniture.",
        "package": "MF_PresetWanderMerchantPackage"
      },
      "campFollower": {
        "_": "Movement-only companion package; target omitted means follow the player.",
        "package": "MF_PresetCampFollowerPackage"
      }
    },
    "identities": {
      "merchant": { "identity": "Merchant", "book": "MF_PresetMerchantLedger" },
      "guard": { "identity": "Guard", "book": "MF_PresetGuardWrit" },
      "paladin": { "identity": "Paladin", "book": "MF_PresetPaladinOath" },
      "dragonborn": { "identity": "Dragonborn", "autoGrantWhen": { "actorValue": "DragonSouls", "threshold": 1 } },
      "adventurer": { "identity": "Adventurer", "default": true }
    }
